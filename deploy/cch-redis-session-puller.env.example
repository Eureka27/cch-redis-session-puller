EXPORT_ROOT=./export
EXPORT_MAX_BYTES=2147483648

# Redis puller
# 推荐显式指定 REDIS_URL；如果留空，可依赖 REDIS_CONTAINER 探测
# 如果运行用户没有 docker.sock 访问权限，请先解析容器 IP 并直接填写 REDIS_URL
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_CONTAINER=claude-code-hub-redis
DEST_DIR=./export/redis/session_events
REDIS_SIDECARS_DIR=./export/redis/request_sidecars
STATE_PATH=./export/state/redis_puller.json
POLL_INTERVAL_SECONDS=30
MISSING_SKIP_SECONDS=300

# DB exporter
# 推荐显式指定 DATABASE_URL/DSN；如留空，可通过 DATABASE_CONTAINER/DB_HOST + DB_USER + DB_PASSWORD + DB_NAME 组装连接
# 如果运行用户没有 docker.sock 访问权限，请先解析容器 IP 并直接填写 DB_HOST
DATABASE_URL=
DSN=
DATABASE_CONTAINER=claude-code-hub-postgres
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=claude_code_hub
DB_EXPORT_DIR=./export/db
DB_STATE_PATH=./export/state/db_exporter.json
DB_POLL_INTERVAL_SECONDS=300
DB_BATCH_SIZE=500
